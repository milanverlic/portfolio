# Copy to .env.local and fill in.

NEXT_PUBLIC_SITE_URL=https://my-portfolio.vercel.app
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-handle
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-handle

# ---------------------------------------------------------------------------
# CONTACT FORM
#
# Nothing to configure. The form posts straight from the browser to Formspree,
# and the endpoint lives in src/lib/constants.ts as FORMSPREE_ENDPOINT. A
# Formspree form id is public by design — it ships in the HTML of every
# Formspree form — so there is no secret to keep here.
#
# To point at a different form, edit FORMSPREE_ENDPOINT.
# ---------------------------------------------------------------------------
